# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Secret used to sign the session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL used in password reset links.
APP_URL="http://localhost:3000"

# SMTP sender — for Gmail this must be the Gmail address (or a verified alias).
EMAIL_FROM="Support <you@gmail.com>"

# Gmail SMTP. Use a Google App Password, not your account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"

# S3-compatible attachment storage. Not needed when running through
# `bun run dev:composer` or Prisma Compute — the bucket binding injects these.
# For direct `next dev`, copy the values from a Prisma bucket access key.
S3_ENDPOINT="http://localhost:4302"
S3_BUCKET="attachments"
S3_ACCESS_KEY_ID="replace-with-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-secret-access-key"
